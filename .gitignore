# Episode bookkeeping. Recordings are regenerable; the paper text is a
# local reference copy and is not redistributed.
_ref/
episodes/*/_video/

.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Scratch directories: working space for a single run, not an artifact.
episodes/_work/
results/_work/
induced/*/.frames/

# `results/_prevmodel/` was listed here and is not scratch any more: it holds the
# runs behind the Results table of docs/results.md, and every file in it is
# tracked. Leaving the rule in place would silently swallow anything added
# there later.
